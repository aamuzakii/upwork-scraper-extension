{
  "name": "Upwork Spider - Alpha Version",
  "action": {
    "default_icon": {
      "32": "green.png",
      "72": "green.png",
      "128": "green.png",
      "512": "green.png"
    }
  },
  "manifest_version": 3,
  "version": "0.1",
  "description": "Create better Upwork UI",
  "permissions": ["activeTab", "alarms", "scripting", "storage"],
  "host_permissions": [
    "https://*.supabase.co/*",
    "https://home-dashboard-lac.vercel.app/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://id.quora.com/profile*"],
      "js": ["content/quora.js"]
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content/twitter.js"]
    },
    {
      "matches": ["https://www.threads.com/*", "https://threads.com/*"],
      "js": ["content/threads.js"],
      "run_at": "document_start"
    },{

    "matches": [
      "https://www.olx.co.id/*",
      "https://olx.co.id/*"
    ],

    "js": ["content/olx.js"]

  },{
  "matches": [
    "https://www.olx.co.id/*",
    "https://olx.co.id/*"
  ],
  "js": ["content/olx-car.js"]
},{
  "matches": [
    "https://www.olx.co.id/*",
    "https://olx.co.id/*"
  ],
  "js": ["content/olx-car-scraper.js"]
},{
  "matches": [
    "https://www.facebook.com/marketplace/*",
    "https://facebook.com/marketplace/*",
    "https://web.facebook.com/marketplace/*"
  ],
  "js": ["content/facebook-marketplace-scraper.js"]
},{
  "matches": [
    "https://www.facebook.com/marketplace/item/*",
    "https://facebook.com/marketplace/item/*",
    "https://web.facebook.com/marketplace/item/*"
  ],
  "js": ["content/facebook-marketplace-detail-scraper.js"]
},{
  "matches": [
    "https://www.rumah123.com/*",
    "https://rumah123.com/*"
  ],
  "js": ["dist/content/rumah123.js"]
}
  ]
}
