{
  "name": "Upwork Spider - Alpha Version",
  "action": {
    "default_icon": {
      "32": "green.png",
      "72": "green.png",
      "128": "green.png",
      "512": "green.png"
    }
  },
  "manifest_version": 3,
  "version": "0.1",
  "description": "Create better Upwork UI",
  "permissions": ["activeTab", "scripting", "storage"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://id.quora.com/profile*"],
      "js": ["content/quora.js"]
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content/twitter.js"]
    },{

    "matches": [
      "https://www.olx.co.id/*",
      "https://olx.co.id/*"
    ],

    "js": ["content/olx.js"]

  },{
  "matches": [
    "https://www.rumah123.com/*",
    "https://rumah123.com/*"
  ],
  "js": ["content/rumah123.js"]
}
  ]
}
